# ═══════════════════════════════════════════════════════════════════════
# ReadMeAI Backend — environment template
# Copy to .env.local (development) or .env.production (production)
# and fill in the values. Loader order: .env.production wins if NODE_ENV=production,
# else .env.local, else .env
# ═══════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:8080
NODE_ENV=development

# Secret used to sign JWT session cookies — CHANGE IN PRODUCTION!
# Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Auto-created bootstrap admin account (remove after first run in production)
ADMIN_EMAIL=admin@readmeai.local
ADMIN_PASSWORD=admin12345

# ── MongoDB ───────────────────────────────────────────────────────────────
# Local docker:  mongodb://localhost:27017/readmeai
# MongoDB Atlas: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/readmeai
MONGO_URI=mongodb://localhost:27017/readmeai

# ── AI (OpenAI) ────────────────────────────────────────────────────────────
# Key: https://platform.openai.com/api-keys
# Without a key the server falls back to a deterministic template (same format).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── GitHub OAuth App ──────────────────────────────────────────────────────
# Create at https://github.com/settings/developers
#   Homepage URL:   http://localhost:5173
#   Callback URL:   http://localhost:4000/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── GitHub (optional server-level token) ──────────────────────────────────
# Personal access token used to analyze PUBLIC repos for users who haven't
# connected GitHub OAuth. Raises the API limit from 60 to 5000 req/hr.
# Create at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=
