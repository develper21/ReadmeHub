    {
      "name": "🐙 GitHub",
      "description": "GitHub OAuth connection + repository access. Tokens are stored AES-256-GCM encrypted. Requires the server env `GITHUB_CLIENT_ID` / `GITHUB_CLIENT_SECRET` for the OAuth flow.",
      "item": [
        {
          "name": "Connection Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/github/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "github",
                "status"
              ]
            },
            "description": "**GET /api/github/status** 🔒\n\nReturns `{ configured, connected, username }`:\n- `configured` — OAuth app configured on the server\n- `connected` — current user has linked GitHub\n- `username` — linked GitHub login (or `null`)"
          },
          "response": []
        },
        {
          "name": "Connect (Start OAuth)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/github/connect",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "github",
                "connect"
              ]
            },
            "description": "**GET /api/github/connect** 🔒\n\nStarts the GitHub OAuth flow (scopes: `read:user user:email repo`).\n\n⚠️ **Postman tip:** turn OFF \"Automatically follow redirects\" for this request — it answers `302` with a `Location` header pointing to `https://github.com/login/oauth/authorize?...`. Best tested by opening the URL in a browser while signed in to the app.\n\nNot configured on server → `501`."
          },
          "response": []
        },
        {
          "name": "OAuth Callback",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/github/callback?code=REAL_CODE_FROM_GITHUB&state=REAL_STATE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "github",
                "callback"
              ],
              "query": [
                {
                  "key": "code",
                  "value": "REAL_CODE_FROM_GITHUB",
                  "description": "One-time code GitHub appended to the redirect URI"
                },
                {
                  "key": "state",
                  "value": "REAL_STATE",
                  "description": "State issued by /connect (valid for 10 minutes)"
                }
              ]
            },
            "description": "**GET /api/github/callback**\n\nOAuth redirect target — GitHub calls this with `?code&state`. Cannot be replayed manually with fake values (invalid/missing state → redirect to `/auth/callback?github=error`).\n\nOn success it links (or signs in) the user, sets the session cookie and redirects to `CLIENT_ORIGIN/auth/callback?github=success`."
          },
          "response": []
        },
        {
          "name": "List My Repos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/github/repos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "github",
                "repos"
              ]
            },
            "description": "**GET /api/github/repos** 🔒\n\nReturns `{ repos: [...], connected }` — private + public repos via the stored OAuth token, or public repos if only a username is linked.\n\nNot connected at all → `400 { error, code: \"GITHUB_NOT_CONNECTED\" }`.\n\nRepo objects: `id, name, fullName, description, htmlUrl, language, stargazersCount, forksCount, openIssuesCount, private, updatedAt` (sorted by last update)."
          },
          "response": []
