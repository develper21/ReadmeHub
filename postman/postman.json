    {
      "name": "🔐 Auth",
      "description": "JWT authentication. Login/Register set the httpOnly cookie `readmeai_token` (7 days) **and** the token can be sent as `Authorization: Bearer {{token}}` (saved automatically by the test scripts).",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.code === 201);",
                  "const cookie = pm.response.headers.get(\"set-cookie\") || \"\";",
                  "const match = cookie.match(/readmeai_token=([^;]+)/);",
                  "if (match) {",
                  "  pm.collectionVariables.set(\"token\", match[1]);",
                  "  console.log(\"✅ readmeai_token saved to collection variable 'token'\");",
                  "}",
                  "if (pm.response.code === 409) console.log(\"⚠️ Email already registered — use Login instead\");"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@readmeai.dev\",\n  \"password\": \"secret123\",\n  \"displayName\": \"New User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "**POST /api/auth/register**\n\nBody (zod: `registerSchema`):\n- `email` (string, email) — required\n- `password` (string, min 6, max 128) — required\n- `displayName` (string, optional)\n\nReturns `201 { user }`. Duplicate email → `409`. The response also sets the session cookie (saved to `{{token}}` by the test script)."
          },
          "response": []
        },
        {
          "name": "Login (Demo User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.code === 200);",
                  "const cookie = pm.response.headers.get(\"set-cookie\") || \"\";",
                  "const match = cookie.match(/readmeai_token=([^;]+)/);",
                  "if (match) {",
                  "  pm.collectionVariables.set(\"token\", match[1]);",
                  "  console.log(\"✅ Logged in as demo user — token saved\");",
                  "}",
