# ═══════════════════════════════════════════════════════════════════════════
# ReadMeAI — Frontend (Vite) environment template
# Copy to .env.local (dev) or set in Netlify UI (production)
# ═══════════════════════════════════════════════════════════════════════════

# Development: leave empty — vite.config.ts proxies /api → http://localhost:4000
# Production (Netlify): set to your Render backend base URL, e.g.
#   VITE_API_URL=https://readmeai-api.onrender.com
# (Empty = same-origin /api — useful with the netlify.toml proxy redirect.)
VITE_API_URL=

# Optional: override the dev-server proxy target
VITE_PROXY_TARGET=http://localhost:4000
