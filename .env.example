# ═══════════════════════════════════════════════════════════════════════
# ReadMeAI Frontend — environment template (Vite)
# Copy to .env.local (development) or .env.production (production build)
# ═══════════════════════════════════════════════════════════════════════
#
# All variables must start with VITE_ to be exposed to the frontend.

# ── API connection ────────────────────────────────────────────────────────
# Development: leave EMPTY → the Vite dev server proxies same-origin /api/*
#              to the backend (see vite.config.ts → server.proxy).
# Production:  set the full backend base URL, e.g. https://api.your-domain.com
#              If empty in production, same-origin /api is assumed.
VITE_API_URL=

# ── Dev server ────────────────────────────────────────────────────────────
# Port for the Vite dev server (default 5173)
VITE_PORT=5173

# Where the dev-server proxy should forward /api requests (your backend)
VITE_PROXY_TARGET=http://localhost:4000
